# Nebius Token Factory — the tutor agent runs on this open model via LiteLLM's
# OpenAI-compatible provider. Create a key at https://tokenfactory.nebius.com/
# (Settings -> API keys).
NEBIUS_API_KEY=...

# Optional overrides (sensible defaults baked into src/llm.py)
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
#
# To see what's actually available on your account (the catalog changes):
#   curl https://api.tokenfactory.nebius.com/v1/models -H "Authorization: Bearer $NEBIUS_API_KEY"
# Prefer plain instruct models over reasoning/"-Thinking" or Hermes-style
# models — the latter tend to embed tool calls as <tool_call> text that
# doesn't always parse cleanly through Nebius' OpenAI-compatible layer.
