# Where the Python agent server (agent/main.py) is running.
TUTOR_AGENT_URL=http://localhost:8123/tutor

# Vocal Bridge — voice input/output for the tutor. Create a key at
# https://vocalbridgeai.com/ (used only server-side, by src/app/api/voice-token).
# Leave blank to disable voice; typed chat works either way.
VOCALBRIDGE_API_KEY=...

# Account-scoped keys (vb_...) also need the id of a voice agent you created on
# Vocal Bridge — set it here, else the mic shows "voice error: TOKEN_FETCH_FAILED".
VOCALBRIDGE_AGENT_ID=...
